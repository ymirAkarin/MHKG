    <!-- http://www.metal_exposure_health.com/ontology#affectsBiomarker -->

    <owl:ObjectProperty rdf:about="http://www.metal_exposure_health.com/ontology#affectsBiomarker">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:comment xml:lang="en">Metal affects a biomarker.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.metal_exposure_health.com/ontology#Metal"/>
        <rdfs:range rdf:resource="http://www.metal_exposure_health.com/ontology#Biomarker"/>
    </owl:ObjectProperty>
    


